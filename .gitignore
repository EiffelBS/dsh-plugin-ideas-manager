node_modules/
*.log

# Local runtime artifacts — never commit these
.migration-review/
.test-*-url.txt
backups/
*-out.txt
# Tool transcripts written while iterating (typecheck / vitest / bundler)
tc*.txt
r[0-9]*.txt
test-*.txt

# Local maintenance tooling (ledger scans, mirror acceptance runs, batch
# workspace moves). It targets one developer's ~/.dsh ledgers, has no use for
# the people installing this plugin, and is therefore not shipped.
# Exception: changelog-notes.mjs builds the GitHub Release body in
# .github/workflows/release.yml, so it stays in the repository.
scripts/*
!scripts/changelog-notes.mjs
!scripts/changelog-notes.d.mts

