node_modules/
*.log

# Local runtime artifacts — never commit these
.migration-review/
.test-*-url.txt
backups/
*-out.txt
# Tool transcripts written while iterating (typecheck / vitest / bundler)
tc*.txt
r[0-9]*.txt
test-*.txt

# Local maintenance tooling (mirror acceptance runs, batch workspace moves).
# It targets one developer's ~/.dsh ledgers, has no use for the people
# installing this plugin, and is therefore not shipped.
# Two exceptions, both referenced by a TRACKED file, which is what makes them
# executable on a fresh clone:
#  - changelog-notes.mjs builds the GitHub Release body in
#    .github/workflows/release.yml;
#  - scan-mojibake.mjs is the command AGENTS.md and docs/mojibake-fix.md tell a
#    reader to run against a ledger. Neither file is shipped either
#    (package.json `files` covers lib/ and src/), so this costs nothing.
scripts/*
!scripts/changelog-notes.mjs
!scripts/changelog-notes.d.mts
!scripts/scan-mojibake.mjs

# Hand-written wire payloads kept at the root while iterating on a verb (they
# are copies of POST /api/ideas/action bodies, so they carry idea titles).
# Committed once by accident in 2026-09; untracked on 2026-10-04 and never
# pushed again — a repo is a public surface, a scratch file is not.
create_idea*.json
triage_idea.json

